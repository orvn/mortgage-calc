---
import { loadGlobal } from '../lib/content';

const { name } = loadGlobal();
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <p class="footer-copy">
      Just another mortgage calculator?
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 1.75rem 4.5rem;
  }

  .footer-copy {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
