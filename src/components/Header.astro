---
import { loadGlobal } from '../lib/content';

const { name } = loadGlobal();
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="site-logo" aria-label={`${name}, go to homepage`}>
      {name}
    </a>
    <div class="header-actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-top: 1.75rem;
  }

  .header-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color 200ms ease;
  }

  .site-logo:hover {
    color: var(--muted);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
</style>
