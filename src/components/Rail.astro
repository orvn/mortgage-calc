---
// Vertical label column on the left edge of a panel
// Turns into a horizontal strip when the panel stacks
---

<div class="rail">
  <div class="rail-label"><slot /></div>
</div>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .rail {
    flex: 0 0 3.25rem;
    display: flex;
    justify-content: center;
    padding: 1.25rem 0;
    border-right: var(--rule-heavy) solid var(--ink);
  }

  .rail-label {
    writing-mode: vertical-rl;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @include xl {
    .rail {
      flex-basis: auto;
      justify-content: flex-start;
      padding: 0.75rem 1.25rem;
      border-right: 0;
      border-bottom: var(--rule-heavy) solid var(--ink);
    }

    .rail-label {
      writing-mode: horizontal-tb;
    }
  }
</style>
