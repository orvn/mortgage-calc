---
// Labelled range slider bound to an Alpine property named by `model`
// `value` is an Alpine expression for the formatted readout
// `off` is an Alpine expression that dims and disables the field when truthy
interface Props {
  id: string;
  label: string;
  model: string;
  range: number[];
  value: string;
  ticks?: string[];
  size?: 'md' | 'lg';
  off?: string;
}

const { id, label, model, range, value, ticks, size = 'md', off } = Astro.props;
const [min, max, step] = range;
---

<div class:list={['field', `field-${size}`]} :class={off ? `{ 'is-off': ${off} }` : undefined}>
  <div class="field-head">
    <div class="field-title">
      <slot name="before" />
      <label for={id}>{label}</label>
      <slot name="badge" />
    </div>
    <output for={id} class="field-value" x-text={value}></output>
  </div>
  <input
    type="range"
    id={id}
    min={min}
    max={max}
    step={step}
    x-model.number={model}
    :style={`'--p:' + pct('${model}')`}
    :disabled={off}
  />
  <div class="field-rule" aria-hidden="true"></div>
  {ticks && (
    <div class="field-ticks" aria-hidden="true">
      <span>{ticks[0]}</span>
      <span>{ticks[1]}</span>
    </div>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .field-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  label {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .field-value {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
    transition: opacity 150ms ease;
  }

  .field-lg .field-value {
    font-size: 1.875rem;
  }

  /* Dashed rule under the track, one tick every 10% */
  .field-rule {
    height: 0.4375rem;
    margin-top: -0.5rem;
    background: repeating-linear-gradient(90deg, var(--ink) 0 var(--rule), transparent var(--rule) 10%);
    border-right: var(--rule) solid var(--ink);
    opacity: 0.5;
    transition: opacity 150ms ease;
  }

  .field-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .is-off .field-value,
  .is-off input {
    opacity: 0.35;
  }

  .is-off .field-rule {
    opacity: 0.18;
  }

  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 1.375rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity 150ms ease;
  }

  input[type='range']:disabled {
    cursor: default;
  }

  input[type='range']:focus-visible {
    outline: none;
  }

  input[type='range']::-webkit-slider-runnable-track {
    height: 0.125rem;
    background-color: color-mix(in srgb, var(--ink) 25%, transparent);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: var(--p, 50%) 100%;
    background-repeat: no-repeat;
  }

  input[type='range']::-moz-range-track {
    height: 0.125rem;
    background: color-mix(in srgb, var(--ink) 25%, transparent);
  }

  input[type='range']::-moz-range-progress {
    height: 0.125rem;
    background: var(--ink);
  }

  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -0.3125rem;
    background: var(--paper);
    border: var(--rule-heavy) solid var(--ink);
    border-radius: 0;
  }

  input[type='range']::-moz-range-thumb {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--paper);
    border: var(--rule-heavy) solid var(--ink);
    border-radius: 0;
  }

  input[type='range']:hover::-webkit-slider-thumb,
  input[type='range']:focus-visible::-webkit-slider-thumb {
    background: var(--ink);
  }

  input[type='range']:hover::-moz-range-thumb,
  input[type='range']:focus-visible::-moz-range-thumb {
    background: var(--ink);
  }
</style>
