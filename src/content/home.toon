meta:
  title: null
  description: Conceptualize what a home purchase really costs each month from factors like price, interest, down payment, rate, term and property tax.
  og_image: /og-default.png

options: null

content:
  rail: Mortgage Calculator
  kicker: Home buying costs demystified
  heading: What will this house cost you each month?
  subheading: Set the price. The figures follow.
  intro: "Price, down payment, rate, term and property tax on the left; monthly cost and a breakdown of the whole on the right. Every figure is an estimate."
  illustration_alt: Elevation drawing of a house
  figures_rail: Figures
  labels:
    price: Home price
    down: Down payment
    rate: Rate
    term: Term (years)
    tax: Property tax
    insured: Insured
    currency: Currency
    region: Region
    land_transfer: Land transfer tax
  results:
    monthly: Monthly payment
    total: Total over {years} years
    with_tax: with property tax
    without_tax: Property tax excluded
    biweekly: bi-weekly
    in_base: in {currency}
  segments:
    principal: Principal
    interest: Interest
    down: Down payment
    tax: Property tax
    insurance: Insurance
    land_transfer: Land transfer tax
  disclaimer: "Estimates only. Converted at {fx}. Property tax is an annual share of price, shown monthly."
  settings:
    currency: CAD
    currencies[2]: CAD,USD
    fx_rate: 0.73
    locale: en-CA
    terms[3]: 20,25,30
    defaults:
      price: 1500000
      down_pct: 20
      rate: 4
      years: 25
      tax_pct: 1
      tax_on: true
      land_transfer_on: true
      region: toronto
    ranges:
      price[3]: 100000,4000000,5000
      down_pct[3]: 5,50,1
      rate[3]: 2,9,0.05
      tax_pct[3]: 0.25,2.5,0.05
    regions:
      toronto:
        name: Toronto
        schedules[2]: ontario,toronto
      ontario:
        name: Ontario
        schedules[1]: ontario
    land_transfer:
      ontario:
        name: Ontario
        brackets[5]{from,rate}:
          0,0.5
          55000,1
          250000,1.5
          400000,2
          2000000,2.5
      toronto:
        name: Toronto
        brackets[10]{from,rate}:
          0,0.5
          55000,1
          250000,1.5
          400000,2
          2000000,2.5
          3000000,4.4
          4000000,5.45
          5000000,6.5
          10000000,7.55
          20000000,8.6
